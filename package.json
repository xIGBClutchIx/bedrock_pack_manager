{
  "name": "bedrock-pack-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Install and manage Minecraft Bedrock behavior and resource packs on local, FTP, FTPS and SFTP servers from a local web UI.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/main.ts --dev --test-server --port 5174 --no-browser",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "build:sea": "npm run build && node scripts/build-sea.mjs",
    "start": "node dist/server.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && playwright test smoke",
    "screenshots": "vite build && playwright test screenshots",
    "bench": "tsx scripts/bench.ts",
    "demo": "tsx scripts/demo-servers.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "basic-ftp": "^6.2.3",
    "fastify": "^5.12.7",
    "jsonc-parser": "^3.3.1",
    "p-limit": "^7.3.3",
    "prismarine-nbt": "^2.8.0",
    "ssh2": "^1.17.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ftp-srv": "^4.6.3",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
