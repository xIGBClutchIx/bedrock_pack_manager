#!/usr/bin/env python3
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


def project_python(root_dir: Path) -> Path:
    scripts_python = root_dir / ".venv" / "Scripts" / "python.exe"
    if scripts_python.exists():
        return scripts_python

    bin_python = root_dir / ".venv" / "bin" / "python"
    if bin_python.exists():
        return bin_python

    raise FileNotFoundError("Local .venv Python was not found. Create the virtual environment before pushing.")


def main() -> int:
    root_dir = Path(__file__).resolve().parents[1]
    try:
        python = project_python(root_dir)
    except FileNotFoundError as exc:
        print(exc, file=sys.stderr)
        return 1

    tmp_dir = root_dir / ".tmp"
    tmp_dir.mkdir(exist_ok=True)
    env = dict(os.environ)
    env["TMPDIR"] = str(tmp_dir)

    result = subprocess.run([str(python), "-m", "pytest"], cwd=root_dir, env=env)
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())
